/.vscode
/.embuild
/target
/data
# SyncServer-backed tests (and a locally run `cargo run -p emulator --bin
# desktop` from that directory) write storage data here too -- the
# root-anchored `/data` above doesn't cover it (Tess flagged).
emulator/data/

# Generated by `cargo run -p pico-link-core --example render_scene` (W3 render
# core PNG-dump verification) — an artifact, not source.
render_scene.png

# Generated by `cargo run -p emulator --example render_via_surfaces` (W4
# host-surface parity verification) — an artifact, not source.
headless_scene.png

# Beads task tracking: .beads/ has its own .gitignore. As of beads 1.2.2 the
# board itself lives in an embedded Dolt DB at .beads/embeddeddolt/, which that
# file ignores — so the board is NOT shared via git. Share it with `bd dolt
# push` (refs/dolt/data on the git remote). Only config, hooks and the
# knowledge/interaction logs are tracked here. Do NOT blanket-ignore .beads/.
.mcp.json

# local git worktrees for bead work
.worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.DS_Store

# Local Claude Code settings (machine-specific)
.claude/settings.json
